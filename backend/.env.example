APP_NAME="Turismo SV"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=es_ES

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=turismo
DB_USERNAME=turismo
DB_PASSWORD=turismo

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=s3
QUEUE_CONNECTION=redis
CACHE_STORE=redis

REDIS_CLIENT=predis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hola@turismo-sv.test"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=turismo
AWS_SECRET_ACCESS_KEY=turismo-secret
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=turismo
AWS_ENDPOINT=http://s3:8333
AWS_URL=http://localhost:8333/turismo
AWS_USE_PATH_STYLE_ENDPOINT=true

BUILDER_URL=http://builder:3100
BUILDER_TOKEN=dev-builder-token-change-me-123456
BUILDER_CALLBACK_BASE=http://php:8000
API_RATE_LIMIT=600
FRONTEND_DEV_URL=

VITE_APP_NAME="${APP_NAME}"
